{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --import ./tests/ts-resolve.mjs --test tests/*.test.mjs && npm run test:render",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:render": "vite build --ssr tests/renderSmoke.tsx --outDir .smoke-out --logLevel error && node .smoke-out/renderSmoke.js && rm -rf .smoke-out"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "docx": "^9.14.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.12.0",
    "jspdf": "^4.2.1",
    "katex": "^0.17.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.39.0",
    "marked": "^18.0.7",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^12.1.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "vis-network": "^10.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
