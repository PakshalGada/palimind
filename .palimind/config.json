{
  "embed_model": "nomic-embed-text",
  "chat_model": "llama3",
  "vision_model": "llava",
  "chunk_size": 1000,
  "chunk_overlap": 200,
  "extensions": [
    ".txt",
    ".md",
    ".py",
    ".js",
    ".ts",
    ".go",
    ".rs",
    ".c",
    ".cpp",
    ".h",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".csv",
    ".html",
    ".rst"
  ],
  "doc_extensions": [
    ".pdf",
    ".docx",
    ".pptx",
    ".xlsx"
  ],
  "image_extensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".webp"
  ],
  "ollama_base_url": "http://localhost:11434"
}